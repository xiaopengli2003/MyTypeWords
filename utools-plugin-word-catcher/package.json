{
  "name": "utools-word-catcher",
  "version": "1.0.0",
  "description": "词捕：uTools 中的 TypeWords 生词本",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node scripts/project.js test",
